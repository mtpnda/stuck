{
  "tasks": {
    "start": "deno run --unstable-kv -A backend/src/main.ts",
    "dev": "deno run --watch --unstable-kv -A backend/src/main.ts",
    "test": "cd backend && deno task test"
  },
  "imports": {
    "hono": "npm:hono@^4.4.0",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^0.14.0",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.4.0",
    "zod": "npm:zod@^3.23.8"
  },
  "exclude": [
    "android",
    "ios",
    "build",
    "fastlane",
    "artemis-ansible-runner"
  ]
}
